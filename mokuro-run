#!/usr/bin/env bash
# Runs mokuro OCR on the manga pages in one or more given directories.
#
# Usage:
#   ./mokuro-run <directory> [<directory> ...] [-- extra mokuro flags]
#
# The venv lives next to this script (in ./.mokuro-venv). Its python3 is
# invoked directly (via full path) instead of sourcing activate.
#
# mokuro always writes "<directory-name>.mokuro" as a sibling of the given
# directory (one level up) — this is hardcoded in mokuro itself. This script
# moves the resulting .mokuro file into the directory afterward, since that's
# the preferred layout here and the reader works fine with it that way. The
# "_ocr" cache directory is left where mokuro put it (next to the directory)
# so re-runs can still reuse cached OCR results. Legacy HTML output is
# disabled.

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $0 <directory> [<directory> ...] [-- extra mokuro flags]" >&2
    exit 1
fi

TARGET_DIRS=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
    TARGET_DIRS+=("$1")
    shift
done
if [ "${1:-}" = "--" ]; then
    shift
fi
EXTRA_ARGS=("$@")

for dir in "${TARGET_DIRS[@]}"; do
    if [ ! -d "$dir" ]; then
        echo "Not a directory: $dir" >&2
        exit 1
    fi
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.mokuro-venv"
VENV_PYTHON="$VENV_DIR/bin/python3"

if [ ! -d "$VENV_DIR" ]; then
    echo "No venv found at $VENV_DIR — creating one and installing mokuro..." >&2
    python3 -m venv "$VENV_DIR"
    "$VENV_PYTHON" -m pip install --upgrade pip -q
    "$VENV_PYTHON" -m pip install mokuro -q
fi

run_mokuro_on_dir() {
    local target_dir
    target_dir="$(cd "$1" && pwd)"

    echo "Running mokuro on: $target_dir"
    "$VENV_PYTHON" -m mokuro --disable_confirmation=True --legacy_html=False "${EXTRA_ARGS[@]}" "$target_dir"

    local dir_name parent_dir generated_mokuro
    dir_name="$(basename "$target_dir")"
    parent_dir="$(dirname "$target_dir")"
    generated_mokuro="$parent_dir/$dir_name.mokuro"

    if [ -f "$generated_mokuro" ]; then
        mv -f "$generated_mokuro" "$target_dir/$dir_name.mokuro"
        echo "Moved mokuro file to: $target_dir/$dir_name.mokuro"
    fi
}

for dir in "${TARGET_DIRS[@]}"; do
    run_mokuro_on_dir "$dir"
done
